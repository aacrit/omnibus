{
  "schema": "omnibus.capture-channels/1",
  "_note": "C3 relevance and channels (capture design, 2026-11-13). A listed item is captured when its score reaches capture_at, or when an always-capture channel matches it. Terms come from the latest `editions` printed editions' top `top_clusters` clusters (cluster titles and deep-dive article titles). The stoplist mirrors the rundown's no-bridge rule from the other side: no-bridge names the week's persons, places and parties-as-actors and lets institutions through, so the institutions and the country's own names are not terms here (they match every item). Rights are never decided here: every captured candidate still runs its adapter's lookup() and checkCandidate.",
  "capture_at": 2,
  "ngram_points": 2,
  "term_points": 1,
  "editions": 3,
  "top_clusters": 15,
  "rescore_hours": 72,
  "stoplist": [
    "United States",
    "United States of America",
    "U.S.",
    "US",
    "USA",
    "America",
    "American",
    "Americans",
    "Congress",
    "Senate",
    "House",
    "House of Representatives",
    "Washington",
    "Washington D.C.",
    "D.C.",
    "White House",
    "Capitol",
    "Supreme Court",
    "Pentagon",
    "Democratic",
    "Democrat",
    "Democrats",
    "Republican",
    "Republicans",
    "President",
    "Vice President",
    "Secretary",
    "Minister",
    "Prime Minister",
    "Prime Ministers",
    "Presidents",
    "Secretaries",
    "Ministers",
    "Government",
    "Administration",
    "Federal",
    "National",
    "State",
    "Department",
    "News",
    "Live",
    "Video",
    "Watch",
    "Update",
    "Updates",
    "Breaking",
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
    "Sunday",
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Sept",
    "Oct",
    "Nov",
    "Dec"
  ],
  "always": [
    {
      "id": "potus-remarks",
      "why": "the President's remarks, gaggles, addresses and statements, from the White House's own feeds and its Commons uploads",
      "sources": ["whitehouse", "commons"],
      "when": [
        { "title": "\\b(?:President (?:Donald )?(?:J\\. )?Trump|POTUS)\\b.*\\b(?:Remarks|Gaggles?|Address(?:es)?|Speech|Statement|Press Conference|Briefing|Interview)\\b" },
        { "title": "\\b(?:Remarks|Address|Statement) by President Trump\\b" }
      ]
    },
    {
      "id": "vp-remarks",
      "why": "the Vice President's remarks and statements",
      "sources": ["whitehouse", "commons"],
      "when": [
        { "title": "\\b(?:Vice President|VP|JD Vance)\\b.*\\b(?:Remarks|Gaggles?|Address(?:es)?|Speech|Statement|Press Conference|Briefing|Interview)\\b" },
        { "title": "\\b(?:Remarks|Address|Statement) by (?:the )?Vice President\\b" }
      ]
    },
    {
      "id": "press-secretary",
      "why": "the White House press secretary's briefings and remarks",
      "sources": ["whitehouse", "commons"],
      "when": [{ "title": "\\bPress Secretary\\b" }, { "title": "\\bWhite House Press Briefing\\b" }]
    },
    {
      "id": "dvids-secwar-osd",
      "why": "the Secretary of War and the Office of the Secretary on DVIDS",
      "sources": ["dvids"],
      "when": [{ "unit": "\\bOffice of the Secretary of (?:War|Defense)\\b|\\bOSD\\b" }, { "title": "\\bSecretary of (?:War|Defense)\\b" }, { "keywords": "\\bSecretary of (?:War|Defense)\\b" }]
    },
    {
      "id": "dvids-joint-staff",
      "why": "the Joint Staff and its Chairman on DVIDS",
      "sources": ["dvids"],
      "when": [{ "unit": "\\bJoint Staff\\b|\\bJoint Chiefs of Staff\\b" }, { "title": "\\bChairman of the Joint Chiefs\\b" }]
    },
    {
      "id": "dvids-centcom",
      "why": "U.S. Central Command on DVIDS",
      "sources": ["dvids"],
      "when": [{ "unit": "\\bCentral Command\\b|\\bCENTCOM\\b" }]
    },
    {
      "id": "state-briefings",
      "why": "the State Department's press briefings",
      "sources": ["commons"],
      "when": [{ "category": "\\bState Department Press Briefings\\b" }, { "title": "\\bDepartment (?:of State )?Press Briefing\\b" }]
    }
  ]
}
